{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Python + C++ Extension",
            "type": "cppdbg",
            "request": "launch",

            "program": "${workspaceFolder}/.venv/bin/python",

            "args": [
                "${file}"
            ],

            "cwd": "${workspaceFolder}",

            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",

            "stopAtEntry": false,
            "externalConsole": false,

            "environment": [
                {
                    "name": "PYTHONPATH",
                    "value": "${workspaceFolder}"
                }
            ],

            "setupCommands": [
                {
                    "description": "Enable GDB pretty printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "Python: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "cwd": "${fileDirname}",
            "console": "integratedTerminal",
            "justMyCode": false,
            "stopOnEntry": false,
            "env": {},
            "args": []
        }
    ]
}